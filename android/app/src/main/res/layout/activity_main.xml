<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Zero-latency hardware video surface (fullscreen canvas for drawing) -->
    <SurfaceView
        android:id="@+id/displaySurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Visual Pointer Crosshair (follows Huion pen in real-time) -->
    <View
        android:id="@+id/cursorIndicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:background="#E0E0E0"
        android:visibility="gone" />

    <!-- Full-Screen Modern Dashboard Overlay -->
    <LinearLayout
        android:id="@+id/overlayLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#121212"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp">

        <!-- Top Header Bar (#181818) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical"
            android:background="#181818">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UltraDisplay"
                    android:textColor="#E0E0E0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/cairo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High-Performance Virtual Tablet Display"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:fontFamily="@font/cairo" />
            </LinearLayout>

            <TextView
                android:id="@+id/headerPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STANDBY"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/cairo"
                android:background="#1E1E1E"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <!-- Segmented Tab Navigation: [ Connect ] [ Settings ] [ About Us ] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="#181818">

            <Button
                android:id="@+id/tabConnectBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Connect"
                android:textColor="#121212"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/cairo"
                android:background="#E0E0E0"
                android:stateListAnimator="@null"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/tabSettingsBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Settings"
                android:textColor="#888888"
                android:textSize="13sp"
                android:fontFamily="@font/cairo"
                android:background="#1C1C1C"
                android:stateListAnimator="@null"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/tabAboutBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="About Us"
                android:textColor="#888888"
                android:textSize="13sp"
                android:fontFamily="@font/cairo"
                android:background="#1C1C1C"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Main Content Area with ScrollView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 1. CONNECT TAB CONTENT -->
                <LinearLayout
                    android:id="@+id/connectContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Connection Mode Selector: [ Wi-Fi ] [ USB Cable ] -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONNECTION MODE"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/cairo"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <Button
                            android:id="@+id/wifiModeBtn"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="Wi-Fi Mode"
                            android:textColor="#121212"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/cairo"
                            android:background="#E0E0E0"
                            android:stateListAnimator="@null"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/cableModeBtn"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="USB Cable Mode"
                            android:textColor="#888888"
                            android:textSize="13sp"
                            android:fontFamily="@font/cairo"
                            android:background="#1C1C1C"
                            android:stateListAnimator="@null" />
                    </LinearLayout>

                    <!-- Connection Card (#1C1C1C) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#1C1C1C"
                        android:padding="20dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mode: Wi-Fi (Local Network)"
                            android:textColor="#E0E0E0"
                            android:textSize="13sp"
                            android:fontFamily="@font/cairo"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HOST PC ADDRESS"
                            android:textColor="#888888"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/cairo"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/hostIpInput"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="192.168.0.89"
                            android:hint="PC IP Address (e.g. 192.168.0.89)"
                            android:textColor="#E0E0E0"
                            android:textColorHint="#555555"
                            android:background="#141414"
                            android:fontFamily="@font/cairo"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textSize="15sp"
                            android:singleLine="true"
                            android:layout_marginBottom="18dp" />

                        <Button
                            android:id="@+id/connectButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Connect to Host PC"
                            android:textColor="#121212"
                            android:background="#E0E0E0"
                            android:fontFamily="@font/cairo"
                            android:stateListAnimator="@null"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Tablet Status Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#181818"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INPUT HARDWARE STATUS"
                            android:textColor="#888888"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/cairo"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/tabletStatusInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stylus Digitizer: Ready (Huion / Active Stylus supported)\nWindows Ink Injection: 8192 Pressure Levels &amp; Tilt"
                            android:textColor="#E0E0E0"
                            android:textSize="12sp"
                            android:fontFamily="@font/cairo"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. SETTINGS TAB CONTENT -->
                <LinearLayout
                    android:id="@+id/settingsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DISPLAY &amp; STREAMING"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/cairo"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#1C1C1C"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp">

                        <Switch
                            android:id="@+id/switch120Hz"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ultra 120 FPS High Refresh Rate"
                            android:textColor="#E0E0E0"
                            android:textSize="14sp"
                            android:fontFamily="@font/cairo"
                            android:checked="true"
                            android:layout_marginBottom="12dp" />

                        <Switch
                            android:id="@+id/switchKeepAwake"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Keep Screen Always On"
                            android:textColor="#E0E0E0"
                            android:textSize="14sp"
                            android:fontFamily="@font/cairo"
                            android:checked="true" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STYLUS &amp; DIAGNOSTICS"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/cairo"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#1C1C1C"
                        android:padding="16dp">

                        <Switch
                            android:id="@+id/switchDebugOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Show Live Coordinates Debug Box"
                            android:textColor="#E0E0E0"
                            android:textSize="14sp"
                            android:fontFamily="@font/cairo"
                            android:checked="true"
                            android:layout_marginBottom="12dp" />

                        <Switch
                            android:id="@+id/switchCursorDot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Show Visual Pointer Crosshair Dot"
                            android:textColor="#E0E0E0"
                            android:textSize="14sp"
                            android:fontFamily="@font/cairo"
                            android:checked="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. ABOUT US TAB CONTENT -->
                <LinearLayout
                    android:id="@+id/aboutContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#1C1C1C"
                        android:padding="20dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UltraDisplay v2.0"
                            android:textColor="#E0E0E0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/cairo"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Created by Rabah Alawadi"
                            android:textColor="#888888"
                            android:textSize="14sp"
                            android:fontFamily="@font/cairo"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UltraDisplay turns your Android phone or tablet into a high-precision, zero-latency graphics drawing display for Windows.\n\nOptimized for Krita, Photoshop, Clip Studio, Illustrator, and OneNote with native Windows Ink pressure and tilt."
                            android:textColor="#A0A0A0"
                            android:textSize="13sp"
                            android:fontFamily="@font/cairo"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:id="@+id/githubLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GitHub: github.com/rabahalawadi/UltraDisplay"
                            android:textColor="#E0E0E0"
                            android:textSize="13sp"
                            android:fontFamily="@font/cairo"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#181818"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KEY TECHNOLOGIES"
                            android:textColor="#888888"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/cairo"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Pure Windows Ink Synthetic Pointer (InjectSyntheticPointerInput)\n• DXGI Desktop Duplication &amp; Hardware Media Foundation H.264\n• High-precision 120 FPS / 25 Mbps streaming engine\n• Native Huion &amp; S-Pen OTG Digitizer support"
                            android:textColor="#A0A0A0"
                            android:textSize="12sp"
                            android:fontFamily="@font/cairo"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </LinearLayout>

            </FrameLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Always-Visible Real-Time Mouse / Huion Tablet Diagnostics Overlay -->
    <TextView
        android:id="@+id/debugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="#DD121212"
        android:padding="10dp"
        android:textColor="#E0E0E0"
        android:textSize="11sp"
        android:fontFamily="@font/cairo"
        android:elevation="12dp"
        android:text="[HUION DEBUG] Move pen over tablet to detect input..." />

    <!-- Tiny status pill in corner during streaming (tapping it re-opens dashboard) -->
    <TextView
        android:id="@+id/statsOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="#DD121212"
        android:padding="8dp"
        android:textColor="#E0E0E0"
        android:textSize="12sp"
        android:fontFamily="@font/cairo"
        android:elevation="12dp"
        android:text="Status: Ready"
        android:visibility="gone" />

</FrameLayout>
